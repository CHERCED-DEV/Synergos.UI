{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "rootDir": "./src",
    "outDir": "../dist/core",
    "paths": {
      "@synergos/contracts": ["../contracts/src/index.ts"],
      "@synergos/shared": ["../shared/src/index.ts"],
      "@synergos/core-assets": ["../core-assets/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts"]
}
