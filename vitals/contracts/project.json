{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "vitals/contracts/src",
  "projectType": "library",
  "tags": [
    "scope:contracts",
    "scope:vitals",
    "framework:agnostic"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/vitals/dist/contracts"
      ],
      "options": {
        "command": "node tools/run.mjs tsc -p vitals/contracts/tsconfig.json"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node tools/run.mjs tsc -p vitals/contracts/tsconfig.json --noEmit"
      }
    }
  }
}
