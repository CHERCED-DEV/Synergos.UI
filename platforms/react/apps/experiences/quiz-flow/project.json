{
  "name": "react-quiz-flow",
  "implicitDependencies": ["react-core", "react-shared"],
  "tags": [
    "scope:experiences",
    "tier:module",
    "type:app",
    "element:quiz-flow",
    "framework:react"
  ],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/platforms/react/dist/quiz-flow"],
      "options": {
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "quiz-flow",
          "ELEMENT_ENTRY": "apps/experiences/quiz-flow/src/main.tsx"
        }
      }
    },
    "serve": {
      "options": {
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "quiz-flow",
          "ELEMENT_ENTRY": "apps/experiences/quiz-flow/src/main.tsx"
        }
      }
    },
    "test": {
      "options": { "cwd": "platforms/react" }
    },
    "lint": {
      "options": {
        "command": "node ../../tools/run.mjs eslint apps/experiences/quiz-flow/src/",
        "cwd": "platforms/react"
      }
    },
    "publish": {}
  }
}
