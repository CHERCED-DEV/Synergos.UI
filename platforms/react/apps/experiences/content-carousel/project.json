{
  "name": "react-content-carousel",
  "implicitDependencies": ["react-core", "react-shared"],
  "tags": [
    "scope:experiences",
    "tier:module",
    "type:app",
    "element:content-carousel",
    "framework:react"
  ],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/platforms/react/dist/content-carousel"],
      "options": {
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "content-carousel",
          "ELEMENT_ENTRY": "apps/experiences/content-carousel/src/main.tsx"
        }
      }
    },
    "serve": {
      "options": {
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "content-carousel",
          "ELEMENT_ENTRY": "apps/experiences/content-carousel/src/main.tsx"
        }
      }
    },
    "test": {
      "options": { "cwd": "platforms/react" }
    },
    "lint": {
      "options": {
        "command": "npx eslint apps/experiences/content-carousel/src/",
        "cwd": "platforms/react"
      }
    }
  }
}
