{
  "name": "react-content-carousel",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "platforms/react/apps/experiences/content-carousel/src",
  "tags": [
    "scope:experiences",
    "tier:module",
    "type:app",
    "element:content-carousel",
    "framework:react"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/platforms/react/dist/content-carousel"],
      "options": {
        "command": "npx vite build",
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "content-carousel",
          "ELEMENT_ENTRY": "apps/experiences/content-carousel/src/main.tsx"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite build --watch",
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "content-carousel",
          "ELEMENT_ENTRY": "apps/experiences/content-carousel/src/main.tsx"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.config.ts",
        "cwd": "platforms/react"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint apps/experiences/content-carousel/src/",
        "cwd": "platforms/react"
      }
    }
  }
}
