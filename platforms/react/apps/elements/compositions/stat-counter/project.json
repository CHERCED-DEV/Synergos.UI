{
  "name": "react-stat-counter",
  "$schema": "../../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "platforms/react/apps/elements/compositions/stat-counter/src",
  "tags": [
    "scope:elements",
    "tier:composition",
    "type:app",
    "element:stat-counter",
    "framework:react"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/platforms/react/dist/stat-counter"],
      "options": {
        "command": "npx vite build",
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "stat-counter",
          "ELEMENT_ENTRY": "apps/elements/compositions/stat-counter/src/main.tsx"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite build --watch",
        "cwd": "platforms/react",
        "env": {
          "ELEMENT_NAME": "stat-counter",
          "ELEMENT_ENTRY": "apps/elements/compositions/stat-counter/src/main.tsx"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.config.ts",
        "cwd": "platforms/react"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint apps/elements/compositions/stat-counter/src/",
        "cwd": "platforms/react"
      }
    }
  }
}
