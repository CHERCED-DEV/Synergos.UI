{
  "name": "elements-compositions-stat-counter",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/elements/compositions/stat-counter/src",
  "tags": [
    "scope:elements",
    "tier:composition",
    "type:app",
    "element:stat-counter",
    "framework:react"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/stat-counter"],
      "options": {
        "command": "npx vite build",
        "cwd": "{workspaceRoot}",
        "env": {
          "ELEMENT_NAME": "stat-counter",
          "ELEMENT_ENTRY": "apps/elements/compositions/stat-counter/src/main.tsx"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite build --watch",
        "cwd": "{workspaceRoot}",
        "env": {
          "ELEMENT_NAME": "stat-counter",
          "ELEMENT_ENTRY": "apps/elements/compositions/stat-counter/src/main.tsx"
        }
      }
    }
  }
}
