{
  "name": "domains-shop-product-card",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/domains/shop/product-card/src",
  "tags": ["scope:domains", "tier:composition", "type:app", "element:product-card", "domain:shop", "framework:angular"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/domains/product-card",
        "browser": "apps/domains/shop/product-card/src/main.ts",
        "index": "apps/domains/shop/product-card/src/index.html",
        "tsConfig": "apps/domains/shop/product-card/tsconfig.app.json"
      },
      "configurations": {
        "production": { "budgets": [{ "type": "initial", "maximumWarning": "200kb", "maximumError": "400kb" }] }
      }
    },
    "serve": { "executor": "@angular/build:dev-server", "options": { "port": 4260 } },
    "lint": { "executor": "@nx/eslint:lint", "options": { "lintFilePatterns": ["apps/domains/shop/product-card/src/**/*.ts"] } },
    "test": { "executor": "@angular/build:unit-test", "options": { "tsConfig": "apps/domains/shop/product-card/tsconfig.spec.json" } }
  }
}
