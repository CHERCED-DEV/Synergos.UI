{
  "name": "domains-shop-price-display",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/domains/shop/price-display/src",
  "tags": ["scope:domains", "tier:primitive", "type:app", "element:price-display", "domain:shop", "framework:angular"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/domains/price-display",
        "browser": "apps/domains/shop/price-display/src/main.ts",
        "index": "apps/domains/shop/price-display/src/index.html",
        "tsConfig": "apps/domains/shop/price-display/tsconfig.app.json"
      },
      "configurations": {
        "production": { "budgets": [{ "type": "initial", "maximumWarning": "80kb", "maximumError": "200kb" }] }
      }
    },
    "serve": { "executor": "@angular/build:dev-server", "options": { "port": 4261 } },
    "lint": { "executor": "@nx/eslint:lint", "options": { "lintFilePatterns": ["apps/domains/shop/price-display/src/**/*.ts"] } }
  }
}
