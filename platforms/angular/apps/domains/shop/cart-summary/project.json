{
  "name": "domains-shop-cart-summary",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/domains/shop/cart-summary/src",
  "tags": ["scope:domains", "tier:module", "type:app", "element:cart-summary", "domain:shop", "framework:angular"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/cart-summary",
        "browser": "apps/domains/shop/cart-summary/src/main.ts",
        "index": "apps/domains/shop/cart-summary/src/index.html",
        "tsConfig": "apps/domains/shop/cart-summary/tsconfig.app.json"
      },
      "configurations": {
        "production": { "budgets": [{ "type": "initial", "maximumWarning": "200kb", "maximumError": "400kb" }] }
      }
    },
    "serve": { "executor": "@angular/build:dev-server", "options": { "port": 4266 } },
    "lint": { "executor": "@nx/eslint:lint", "options": { "lintFilePatterns": ["apps/domains/shop/cart-summary/src/**/*.ts"] } }
  }
}
