{
  "name": "experiences-insight-explorer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/experiences/insight-explorer/src",
  "tags": [
    "scope:experiences",
    "tier:experience",
    "type:app",
    "element:insight-explorer",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/insight-explorer",
        "browser": "apps/experiences/insight-explorer/src/main.ts",
        "index": "apps/experiences/insight-explorer/src/index.html",
        "tsConfig": "apps/experiences/insight-explorer/tsconfig.app.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "250kb",
              "maximumError": "500kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": { "port": 4261 }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "port": 4261,
        "staticFilePath": "dist/insight-explorer/browser"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/experiences/insight-explorer/src/**/*.ts",
          "apps/experiences/insight-explorer/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/experiences/insight-explorer/tsconfig.spec.json"
      }
    }
  }
}
