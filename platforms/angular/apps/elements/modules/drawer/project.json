{
  "name": "elements-modules-drawer",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/modules/drawer/src",
  "tags": [
    "scope:elements",
    "tier:module",
    "type:app",
    "element:drawer",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/drawer",
        "browser": "apps/elements/modules/drawer/src/main.ts",
        "index": "apps/elements/modules/drawer/src/index.html",
        "tsConfig": "apps/elements/modules/drawer/tsconfig.app.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "80kb", "maximumError": "200kb" }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": { "port": 4324 }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/modules/drawer/src/**/*.ts",
          "apps/elements/modules/drawer/src/**/*.html"
        ]
      }
    }
  }
}
