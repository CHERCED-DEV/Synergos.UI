{
  "name": "elements-modules-countdown-digital",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/modules/countdown-digital/src",
  "tags": [
    "scope:elements",
    "tier:module",
    "type:app",
    "element:countdown-digital",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/countdown-digital",
        "browser": "apps/elements/modules/countdown-digital/src/main.ts",
        "index": "apps/elements/modules/countdown-digital/src/index.html",
        "tsConfig": "apps/elements/modules/countdown-digital/tsconfig.app.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            { "type": "initial", "maximumWarning": "80kb", "maximumError": "200kb" }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": { "port": 4320 }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/modules/countdown-digital/src/**/*.ts",
          "apps/elements/modules/countdown-digital/src/**/*.html"
        ]
      }
    }
  }
}
