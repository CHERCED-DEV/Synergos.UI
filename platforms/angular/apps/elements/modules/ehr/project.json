{
  "name": "elements-modules-ehr",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/modules/ehr/src",
  "tags": [
    "scope:elements",
    "tier:module",
    "type:app",
    "element:ehr",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "dependsOn": [],
      "options": {
        "outputPath": "dist/ehr",
        "browser": "apps/elements/modules/ehr/src/main.ts",
        "index": "apps/elements/modules/ehr/src/index.html",
        "tsConfig": "apps/elements/modules/ehr/tsconfig.app.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "440kb",
              "maximumError": "540kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4357
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/modules/ehr/src/**/*.ts",
          "apps/elements/modules/ehr/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/elements/modules/ehr/tsconfig.spec.json"
      }
    }
  }
}
