{
  "name": "elements-modules-feature-grid",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/modules/feature-grid/src",
  "tags": [
    "scope:elements",
    "tier:module",
    "type:app",
    "element:feature-grid",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/feature-grid",
        "browser": "apps/elements/modules/feature-grid/src/main.ts",
        "index": "apps/elements/modules/feature-grid/src/index.html",
        "tsConfig": "apps/elements/modules/feature-grid/tsconfig.app.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "200kb",
              "maximumError": "500kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4254
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "port": 4254,
        "staticFilePath": "dist/feature-grid/browser"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/modules/feature-grid/src/**/*.ts",
          "apps/elements/modules/feature-grid/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/elements/modules/feature-grid/tsconfig.spec.json"
      }
    }
  }
}
