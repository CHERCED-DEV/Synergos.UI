{
  "name": "elements-modules-banner",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/modules/banner/src",
  "tags": [
    "scope:elements",
    "tier:module",
    "type:app",
    "element:banner",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/banner",
        "browser": "apps/elements/modules/banner/src/main.ts",
        "index": "apps/elements/modules/banner/src/index.html",
        "tsConfig": "apps/elements/modules/banner/tsconfig.app.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "200kb",
              "maximumError": "500kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4251
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "port": 4251,
        "staticFilePath": "dist/banner/browser"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/modules/banner/src/**/*.ts",
          "apps/elements/modules/banner/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/elements/modules/banner/tsconfig.spec.json"
      }
    }
  }
}
