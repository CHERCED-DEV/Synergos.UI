{
  "name": "elements-primitives-container-block",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/primitives/container-block/src",
  "tags": [
    "scope:elements",
    "tier:primitive",
    "type:app",
    "element:container-block",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/container-block",
        "browser": "apps/elements/primitives/container-block/src/main.ts",
        "index": "apps/elements/primitives/container-block/src/index.html",
        "tsConfig": "apps/elements/primitives/container-block/tsconfig.app.json"
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "100kb",
              "maximumError": "200kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4215
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "port": 4215,
        "staticFilePath": "dist/container-block/browser"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/primitives/container-block/src/**/*.ts",
          "apps/elements/primitives/container-block/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "tsConfig": "apps/elements/primitives/container-block/tsconfig.spec.json"
      }
    }
  }
}
