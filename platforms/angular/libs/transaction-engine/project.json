{
  "name": "transaction-engine",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/transaction-engine/src",
  "projectType": "library",
  "tags": [
    "scope:libs",
    "type:lib",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": [
        "{workspaceRoot}/dist/{projectRoot}"
      ],
      "options": {
        "project": "libs/transaction-engine/ng-package.json",
        "tsConfig": "libs/transaction-engine/tsconfig.lib.json"
      },
      "configurations": {
        "development": {},
        "production": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/transaction-engine/src/**/*.ts",
          "libs/transaction-engine/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "runner": "vitest",
        "tsConfig": "libs/transaction-engine/tsconfig.spec.json",
        "runnerConfig": "libs/transaction-engine/vitest.config.ts",
        "coverageReporters": [
          "text",
          "lcov",
          "html"
        ]
      }
    }
  }
}
