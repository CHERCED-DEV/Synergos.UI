{
  "name": "rendering",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/rendering/src",
  "projectType": "library",
  "tags": [
    "scope:rendering",
    "type:lib",
    "framework:angular"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p libs/rendering/tsconfig.lib.json --noEmit"
      },
      "configurations": {
        "production": {},
        "development": {}
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/rendering/src/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "runner": "vitest",
        "tsConfig": "libs/rendering/tsconfig.spec.json",
        "runnerConfig": "libs/rendering/vitest.config.ts",
        "coverageReporters": [
          "text",
          "lcov",
          "html"
        ]
      }
    }
  }
}
