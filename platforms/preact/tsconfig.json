{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@synergos/contracts": ["../../vitals/contracts/src/index.ts"],
      "@synergos/core": ["../../vitals/core/src/index.ts"],
      "@synergos/core/inputs": ["../../vitals/core/src/inputs/index.ts"],
      "@synergos/core-assets": ["../../vitals/core-assets/src/index.ts"],
      "@synergos/preact-core": ["./libs/core/src/index.ts"],
      "@synergos/preact-shared": ["./libs/shared/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "libs/**/*.ts", "libs/**/*.tsx"]
}
