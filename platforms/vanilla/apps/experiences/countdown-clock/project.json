{
  "name": "vanilla-countdown-clock",
  "implicitDependencies": ["vanilla-core", "vanilla-shared"],
  "tags": [
    "scope:experiences",
    "tier:module",
    "type:app",
    "element:countdown-clock",
    "framework:vanilla"
  ],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/platforms/vanilla/dist/countdown-clock"],
      "options": {
        "cwd": "platforms/vanilla",
        "env": {
          "ELEMENT_NAME": "countdown-clock",
          "ELEMENT_ENTRY": "apps/experiences/countdown-clock/src/main.ts"
        }
      }
    },
    "serve": {
      "options": {
        "cwd": "platforms/vanilla",
        "env": {
          "ELEMENT_NAME": "countdown-clock",
          "ELEMENT_ENTRY": "apps/experiences/countdown-clock/src/main.ts"
        }
      }
    },
    "test": {
      "options": { "cwd": "platforms/vanilla" }
    },
    "lint": {
      "options": {
        "command": "npx eslint apps/experiences/countdown-clock/src/",
        "cwd": "platforms/vanilla"
      }
    },
    "publish": {}
  }
}
