{
  "name": "vanilla-hello-world",
  "tags": [
    "scope:elements",
    "tier:primitive",
    "type:app",
    "element:hello-world",
    "framework:vanilla"
  ],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/platforms/vanilla/dist/hello-world"],
      "options": {
        "cwd": "platforms/vanilla",
        "env": {
          "ELEMENT_NAME": "hello-world",
          "ELEMENT_ENTRY": "apps/elements/primitives/hello-world/src/main.ts"
        }
      }
    },
    "serve": {
      "options": {
        "cwd": "platforms/vanilla",
        "env": {
          "ELEMENT_NAME": "hello-world",
          "ELEMENT_ENTRY": "apps/elements/primitives/hello-world/src/main.ts"
        }
      }
    },
    "test": {
      "options": { "cwd": "platforms/vanilla" }
    },
    "lint": {
      "options": {
        "command": "node ../../tools/run.mjs eslint apps/elements/primitives/hello-world/src/",
        "cwd": "platforms/vanilla"
      }
    },
    "publish": {}
  }
}
