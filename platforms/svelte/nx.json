{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/**/*.test.ts",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs"
    ],
    "vitals": [
      "{workspaceRoot}/../../vitals/contracts/src/**/*",
      "{workspaceRoot}/../../vitals/core/src/**/*",
      "{workspaceRoot}/../../vitals/core-assets/src/**/*",
      "{workspaceRoot}/../../vitals/shared/src/**/*"
    ]
  },
  "targetDefaults": {
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["production", "^production", "vitals"],
      "options": {
        "command": "npx vite build"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite build --watch"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^production", "vitals"],
      "options": {
        "command": "npx vitest run --config vitest.config.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default"]
    },
    "publish": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "cache": false,
      "options": {
        "command": "node ../../tools/publish-element.mjs --project={projectName}"
      }
    }
  }
}
