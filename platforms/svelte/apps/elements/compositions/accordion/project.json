{
  "name": "svelte-accordion",
  "tags": [
    "scope:elements",
    "tier:composition",
    "type:app",
    "element:accordion",
    "framework:svelte"
  ],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/platforms/svelte/dist/accordion"],
      "options": {
        "cwd": "platforms/svelte",
        "env": {
          "ELEMENT_NAME": "accordion",
          "ELEMENT_ENTRY": "apps/elements/compositions/accordion/src/main.ts"
        }
      }
    },
    "serve": {
      "options": {
        "cwd": "platforms/svelte",
        "env": {
          "ELEMENT_NAME": "accordion",
          "ELEMENT_ENTRY": "apps/elements/compositions/accordion/src/main.ts"
        }
      }
    },
    "test": {
      "options": { "cwd": "platforms/svelte" }
    },
    "lint": {
      "options": {
        "command": "npx eslint apps/elements/compositions/accordion/src/",
        "cwd": "platforms/svelte"
      }
    }
  }
}
