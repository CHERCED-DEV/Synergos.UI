{
  "name": "elements-compositions-accordion",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/elements/compositions/accordion/src",
  "tags": [
    "scope:elements",
    "tier:composition",
    "type:app",
    "element:accordion",
    "framework:svelte"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/accordion"],
      "options": {
        "command": "npx vite build",
        "cwd": "{workspaceRoot}",
        "env": {
          "ELEMENT_NAME": "accordion",
          "ELEMENT_ENTRY": "apps/elements/compositions/accordion/src/main.ts"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite build --watch",
        "cwd": "{workspaceRoot}",
        "env": {
          "ELEMENT_NAME": "accordion",
          "ELEMENT_ENTRY": "apps/elements/compositions/accordion/src/main.ts"
        }
      }
    }
  }
}
