{
  "name": "svelte-filter-board",
  "implicitDependencies": ["svelte-core"],
  "tags": [
    "scope:experiences",
    "tier:module",
    "type:app",
    "element:filter-board",
    "framework:svelte"
  ],
  "targets": {
    "build": {
      "outputs": ["{workspaceRoot}/platforms/svelte/dist/filter-board"],
      "options": {
        "cwd": "platforms/svelte",
        "env": {
          "ELEMENT_NAME": "filter-board",
          "ELEMENT_ENTRY": "apps/experiences/filter-board/src/main.ts"
        }
      }
    },
    "serve": {
      "options": {
        "cwd": "platforms/svelte",
        "env": {
          "ELEMENT_NAME": "filter-board",
          "ELEMENT_ENTRY": "apps/experiences/filter-board/src/main.ts"
        }
      }
    },
    "test": {
      "options": { "cwd": "platforms/svelte" }
    },
    "lint": {
      "options": {
        "command": "npx eslint apps/experiences/filter-board/src/",
        "cwd": "platforms/svelte"
      }
    },
    "publish": {}
  }
}
