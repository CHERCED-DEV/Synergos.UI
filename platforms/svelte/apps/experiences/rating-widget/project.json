{
  "name": "svelte-rating-widget",
  "$schema": "../../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "platforms/svelte/apps/experiences/rating-widget/src",
  "tags": [
    "scope:experiences",
    "tier:module",
    "type:app",
    "element:rating-widget",
    "framework:svelte"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/platforms/svelte/dist/rating-widget"],
      "options": {
        "command": "npx vite build",
        "cwd": "platforms/svelte",
        "env": {
          "ELEMENT_NAME": "rating-widget",
          "ELEMENT_ENTRY": "apps/experiences/rating-widget/src/main.ts"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vite build --watch",
        "cwd": "platforms/svelte",
        "env": {
          "ELEMENT_NAME": "rating-widget",
          "ELEMENT_ENTRY": "apps/experiences/rating-widget/src/main.ts"
        }
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run --config vitest.config.ts",
        "cwd": "platforms/svelte"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx eslint apps/experiences/rating-widget/src/",
        "cwd": "platforms/svelte"
      }
    }
  }
}
