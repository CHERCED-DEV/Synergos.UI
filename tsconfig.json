{
  "compilerOptions": {
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "emitDecoratorMetadata": false,
    "target": "es2022",
    "module": "preserve",
    "lib": ["es2022", "dom"],
    "paths": {
      "@synergos/core": ["libs/core/src/index.ts"],
      "@synergos/shared": ["libs/shared/src/index.ts"],
      "@synergos/core-assets": ["libs/core-assets/src/index.ts"],
      "@synergos/rendering": ["libs/rendering/src/index.ts"],
      "@synergos/integrations": ["libs/integrations/src/index.ts"]
    },
    "isolatedModules": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "compileOnSave": false,
  "exclude": ["node_modules", "dist", "tmp"]
}
