{
  "name": "rendering",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/rendering/src",
  "projectType": "library",
  "tags": ["scope:rendering", "type:lib"],
  "targets": {
    "build": {
      "executor": "@angular/build:ng-packagr",
      "outputs": ["{workspaceRoot}/dist/{projectRoot}"],
      "options": {
        "project": "libs/rendering/ng-package.json"
      },
      "configurations": {
        "production": {
          "tsConfig": "libs/rendering/tsconfig.lib.json"
        },
        "development": {
          "tsConfig": "libs/rendering/tsconfig.lib.json"
        }
      },
      "defaultConfiguration": "production"
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/rendering/src/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "runner": "vitest",
        "tsConfig": "libs/rendering/tsconfig.spec.json",
        "runnerConfig": "libs/rendering/vitest.config.ts",
        "coverageReporters": ["text", "lcov", "html"]
      }
    }
  }
}
