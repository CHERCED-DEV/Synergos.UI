{
  "name": "integrations",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/integrations/src",
  "projectType": "library",
  "tags": ["scope:integrations", "type:lib"],
  "targets": {
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "libs/integrations/src/**/*.ts"
        ]
      }
    },
    "test": {
      "executor": "@nx/js:node",
      "options": {
        "command": "vitest run --config libs/integrations/vitest.config.ts"
      }
    }
  }
}
