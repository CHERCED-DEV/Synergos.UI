{
  "name": "synergos-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Synergos UI — Multi-framework Web Components workspace",
  "scripts": {

    "// ─── CLI ────────────────────────────────────────────────────────────────": "",
    "cli":                        "node tools/cli.mjs",
    "c":                          "node tools/cli.mjs",

    "// ─── BUILD (orquesta plataformas) ───────────────────────────────────────": "",
    "build":                      "npm run build:angular && npm run build:runtime && npm run build:react && npm run build:svelte && npm run build:vanilla",
    "build:angular":              "npm run --prefix platforms/angular build",
    "build:react":                "npm run --prefix platforms/react build",
    "build:svelte":               "npm run --prefix platforms/svelte build",
    "build:vanilla":              "npm run --prefix platforms/vanilla build",
    "build:runtime":              "node tools/build-runtime.mjs",
    "build:runtime:dry":          "node tools/build-runtime.mjs --dry-run",
    "build:experiences":          "npm run --prefix platforms/angular build:experiences && npm run build:react && npm run build:svelte && npm run build:vanilla",

    "// ─── TEST (orquesta plataformas) ────────────────────────────────────────": "",
    "test":                       "npm run test:angular && npm run test:react && npm run test:svelte && npm run test:vanilla",
    "test:angular":               "npm run --prefix platforms/angular test",
    "test:react":                 "npm run --prefix platforms/react test",
    "test:svelte":                "npm run --prefix platforms/svelte test",
    "test:vanilla":               "npm run --prefix platforms/vanilla test",

    "// ─── LINT (orquesta plataformas) ────────────────────────────────────────": "",
    "lint":                       "npm run lint:angular && npm run lint:react && npm run lint:svelte && npm run lint:vanilla",
    "lint:angular":               "npm run --prefix platforms/angular lint",
    "lint:react":                 "npm run --prefix platforms/react lint",
    "lint:svelte":                "npm run --prefix platforms/svelte lint",
    "lint:vanilla":               "npm run --prefix platforms/vanilla lint",

    "// ─── RELEASE (build + validate + publish) ──────────────────────────────": "",
    "release":                    "npm run build && npm run contracts:validate && npm run publish:runtime && node tools/publish.mjs --verify --clean",
    "release:angular":            "npm run build:angular && npm run build:runtime && npm run contracts:validate && npm run publish:runtime && node tools/publish.mjs --framework angular --verify --clean",
    "release:react":              "npm run build:react   && npm run contracts:validate && node tools/publish.mjs --framework react    --verify --clean",
    "release:svelte":             "npm run build:svelte  && npm run contracts:validate && node tools/publish.mjs --framework svelte   --verify --clean",
    "release:vanilla":            "npm run build:vanilla && npm run contracts:validate && node tools/publish.mjs --framework vanilla  --verify --clean",

    "// ─── PUBLISH (solo sube a CDN, sin build) ──────────────────────────────": "",
    "publish:cdn":                "node tools/publish.mjs",
    "publish:runtime":            "node tools/publish-runtime.mjs",
    "release:cdn":                "node tools/release-cdn.mjs",

    "// ─── HERRAMIENTAS ───────────────────────────────────────────────────────": "",
    "dev:cdn":                    "node tools/dev-cdn.mjs",
    "dev:cdn:stop":               "node tools/dev-cdn-stop.mjs",
    "dev:cdn:react":              "node tools/dev-cdn-vite.mjs --framework=react",
    "dev:cdn:svelte":             "node tools/dev-cdn-vite.mjs --framework=svelte",
    "dev:cdn:vanilla":            "node tools/dev-cdn-vite.mjs --framework=vanilla",
    "publish:element":            "node tools/publish-element.mjs",
    "clean:dist":                 "node tools/clean-dist.mjs",
    "manifest:gen":               "node tools/manifest-gen.mjs",
    "manifest:validate":          "node tools/manifest-gen.mjs --validate",
    "element:audit":              "node tools/element-contract-audit.mjs",
    "contracts:validate":         "npm run element:audit && npm run manifest:validate",
    "contracts:export":           "node tools/contracts-export.mjs",
    "catalog":                    "node tools/catalog.mjs",

    "// ─── GRAPHS ─────────────────────────────────────────────────────────────": "",
    "graph":                      "npx nx graph",
    "graph:angular":              "npm run --prefix platforms/angular graph",
    "graph:react":                "npm run --prefix platforms/react graph",
    "graph:svelte":               "npm run --prefix platforms/svelte graph",
    "graph:vanilla":              "npm run --prefix platforms/vanilla graph",

    "// ─── SETUP ──────────────────────────────────────────────────────────────": "",
    "setup":                      "npm run setup:angular && npm run setup:react && npm run setup:svelte && npm run setup:vanilla",
    "setup:angular":              "npm install --prefix platforms/angular",
    "setup:react":                "npm install --prefix platforms/react",
    "setup:svelte":               "npm install --prefix platforms/svelte",
    "setup:vanilla":              "npm install --prefix platforms/vanilla"

  },
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@inquirer/prompts": "^7.0.0",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^4.0.18",
    "cross-env": "^7.0.3",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "glob": "^11.0.0",
    "jsdom": "^27.1.0",
    "nx": "22.5.4",
    "prettier": "~3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.3.5",
    "vitest": "^4.0.8"
  }
}
