{
  "name": "synergos-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Synergos UI — Multi-framework Web Components workspace",
  "scripts": {
    "// ─── CLI ───────────────────────────────────────────────────────────────": "",
    "cli": "node tools/cli.mjs",
    "c": "node tools/cli.mjs",
    "// ─── BUILD — Angular es LA plataforma (purga 2026-08-04) ───────────────": "",
    "prebuild": "node tools/setup.mjs --verificar",
    "build": "npm run build:vitals && npm run build:angular && npm run build:preact && npm run build:runtime",
    "build:vitals": "node tools/build-vitals.mjs",
    "build:angular": "npm run --prefix platforms/angular build",
    "build:preact": "npm run --prefix platforms/preact build",
    "build:runtime": "node tools/build-runtime.mjs",
    "build:runtime:dry": "node tools/build-runtime.mjs --dry-run",
    "build:cdn": "node tools/build-cdn.mjs",
    "dev": "npm run --prefix platforms/angular dev",
    "// ─── TEST / LINT ───────────────────────────────────────────────────────": "",
    "pretest": "node tools/setup.mjs --verificar",
    "// test — corre TODOS los `test:*` de este package.json, en su orden, y sale 1 si alguno falló (#79). Era un encadenado con `&&` y el primer rojo escondía a los siguientes: en Windows, 4 rojos de separador en test:tools dejaban sin correr 1.601 tests. Un tramo nuevo entra solo con llamarse test:<algo>": "",
    "test": "node tools/test-todo.mjs",
    "// test:contratos — los OCHO gates que no necesitan al hermano ni la red (~1 s; el quinto, gate:gemelas, lo sumó #81, el sexto, gate:regiones-vivas, #82, y el séptimo y el octavo, gate:diccionario y gate:literales, el piloto de la ADR 0136, CMS#186). Van en npm test porque no los corría NADIE: `contracts:validate` sólo se teclea a mano, y por ese hueco vivieron dos defectos de #74 —la obligación 3 fallando para todas las plataformas y la 8 acusando a Preact de no tener adaptador—. Los otros tres del encadenado piden SYNERGOS_CMS_PATH, así que corren en el despliegue": "",
    "test:contratos": "npm run element:audit && npm run manifest:validate && npm run gate:clientes && npm run gate:design-system && npm run gate:gemelas && npm run gate:regiones-vivas && npm run gate:diccionario && npm run gate:literales",
    "test:tools": "npx vitest run tools/lib",
    "// test:vitals — --dir y NO un filtro de substring: `vitest run vitals` casaría cualquier ruta que contenga esa cadena, que es el defecto que costó dos cierres de ticket": "",
    "test:vitals": "npx vitest run --dir vitals",
    "test:angular": "npm run --prefix platforms/angular test",
    "// test:preact — corre contra el BUNDLE construido, no contra el fuente: es lo único que ve que falte customElements.define (#64)": "",
    "test:preact": "npm run --prefix platforms/preact test",
    "lint:angular": "npm run --prefix platforms/angular lint",
    "// ─── RELEASE / PUBLISH ─────────────────────────────────────────────────": "",
    "release": "npm run build && npm run contracts:validate && npm run publish:runtime && node tools/publish.mjs",
    "publish:cdn": "node tools/publish.mjs",
    "publish:runtime": "node tools/publish-runtime.mjs",
    "release:cdn": "node tools/release-cdn.mjs",
    "// ─── HERRAMIENTAS ──────────────────────────────────────────────────────": "",
    "// predev:cdn — el mismo gancho que pretest/prebuild (#88): en un árbol sin node_modules, dev:cdn moría con «Cannot find module esbuild» desde build-runtime, sin decir qué teclear": "",
    "predev:cdn": "node tools/setup.mjs --verificar",
    "dev:cdn": "node tools/dev-cdn.mjs",
    "clean:dist": "node tools/clean-dist.mjs",
    "manifest:gen": "node tools/manifest-gen.mjs",
    "manifest:validate": "node tools/manifest-gen.mjs --validate",
    "element:audit": "node tools/element-contract-audit.mjs",
    "gate:clientes": "node tools/clientes-sin-llamador.mjs",
    "gate:design-system": "node tools/consumidores-del-design-system.mjs",
    "gate:design-system:baseline": "node tools/consumidores-del-design-system.mjs --actualizar",
    "gate:gemelas": "node tools/gemelas-del-design-system.mjs",
    "gate:regiones-vivas": "node tools/regiones-vivas.mjs",
    "gate:regiones-vivas:baseline": "node tools/regiones-vivas.mjs --actualizar",
    "// gate:diccionario y gate:literales — los dos del piloto de la ADR 0136 del CMS (CMS#186): cada t('Clave') de un elemento está en las claves que declara su record y ninguna librería traduce; y ningún elemento suma textos de interfaz escritos a mano (línea base: :baseline la reescribe, el diff va en el commit que lo causó)": "",
    "gate:diccionario": "node tools/diccionario-de-elementos.mjs",
    "gate:literales": "node tools/literales-visibles.mjs",
    "gate:literales:baseline": "node tools/literales-visibles.mjs --actualizar",
    "gate:hipoteca": "node tools/vectores-hipoteca.mjs",
    "gate:rutas": "node tools/rutas-del-borde.mjs",
    "contratos:synhost": "node tools/contrato-synhost.mjs",
    "contratos:synhost:check": "node tools/contrato-synhost.mjs --check",
    "humo:cdn": "node tools/humo-cdn.mjs",
    "size:check": "node tools/check-size-budget.mjs",
    "size:baseline": "node tools/check-size-budget.mjs --update",
    "cms:validate": "node tools/validate-cms-contracts.mjs",
    "cms:sync": "node tools/cms-sync.mjs",
    "cms:sync:check": "node tools/cms-sync.mjs --dry-run",
    "contracts:validate": "npm run sync:tokens:check && npm run element:audit && npm run manifest:validate && npm run gate:clientes && npm run gate:design-system && npm run gate:gemelas && npm run gate:regiones-vivas && npm run gate:diccionario && npm run gate:literales && npm run gate:hipoteca && npm run gate:rutas && npm run contratos:synhost:check && npm run cms:validate && npm run cms:sync:check",
    "contracts:export": "node tools/contracts-export.mjs",
    "catalog": "node tools/catalog.mjs",
    "// ─── SETUP ─────────────────────────────────────────────────────────────": "",
    "setup": "node tools/setup.mjs",
    "// ─── ALIAS sync tokens (Cap-250 Batch D) ───────────────────────────────": "",
    "sync:tokens": "npm run --prefix platforms/angular sync:tokens",
    "sync:tokens:check": "npm run --prefix platforms/angular sync:tokens:check",
    "prepare": "husky",
    "// publish de UN elemento: npm run publish:cdn -- --element hero": ""
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "0.25.12",
    "glob": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wrangler": "4.118.0"
  }
}
