{
  "name": "synergos-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Synergos UI — Multi-framework Web Components workspace",
  "scripts": {
    "cli": "node tools/cli.mjs",
    "c": "node tools/cli.mjs",

    "build": "npm run build:angular && npm run build:react && npm run build:svelte",
    "build:angular": "cd platforms/angular && npx nx run-many --target=build --projects=tag:scope:elements",
    "build:react": "npx nx run-many --target=build --projects=tag:framework:react",
    "build:svelte": "npx nx run-many --target=build --projects=tag:framework:svelte",
    "build:vanilla": "cd platforms/vanilla && npx vite build",
    "publish:cdn": "node tools/publish.mjs",
    "release": "npm run build && node tools/publish.mjs",

    "test": "cd platforms/angular && npx nx run-many --target=test",
    "lint": "cd platforms/angular && npx nx run-many --target=lint",
    "graph": "npx nx graph",
    "graph:angular": "cd platforms/angular && npx nx graph",

    "setup": "npm run setup:angular && npm run setup:react && npm run setup:svelte && npm run setup:vanilla",
    "setup:angular": "cd platforms/angular && npm install",
    "setup:react": "cd platforms/react && npm install",
    "setup:svelte": "cd platforms/svelte && npm install",
    "setup:vanilla": "cd platforms/vanilla && npm install"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.0.0",
    "glob": "^11.0.0",
    "nx": "22.5.4"
  }
}
