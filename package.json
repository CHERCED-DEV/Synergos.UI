{
  "name": "synergos-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Synergos UI — Multi-framework Web Components workspace",
  "scripts": {
    "cli": "node tools/cli.mjs",
    "c": "node tools/cli.mjs",

    "build": "npx nx run-many --target=build",
    "build:angular": "cd platforms/angular && npx nx run-many --target=build --projects=tag:scope:elements",
    "build:react": "cd platforms/react && npx nx run-many --target=build",
    "build:svelte": "cd platforms/svelte && npx nx run-many --target=build",
    "build:vanilla": "cd platforms/vanilla && npx nx run-many --target=build",

    "test": "npx nx run-many --target=test",
    "lint": "npx nx run-many --target=lint",
    "graph": "npx nx graph",

    "setup": "cd platforms/angular && npm install && cd ../react && npm install && cd ../svelte && npm install && cd ../vanilla && npm install",
    "setup:angular": "cd platforms/angular && npm install",
    "setup:react": "cd platforms/react && npm install",
    "setup:svelte": "cd platforms/svelte && npm install",
    "setup:vanilla": "cd platforms/vanilla && npm install"
  },
  "devDependencies": {
    "@inquirer/prompts": "^7.0.0",
    "glob": "^11.0.0",
    "nx": "22.5.4"
  }
}
