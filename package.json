{
  "name": "@synergos/ui",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "nx watch --projects=tag:scope:elements -- nx build {}",
    "build": "nx run-many --target=build --projects=tag:scope:elements",
    "build:primitives": "nx run-many --target=build --projects=tag:tier:primitive",
    "build:compositions": "nx run-many --target=build --projects=tag:tier:composition",
    "build:modules": "nx run-many --target=build --projects=tag:tier:module",
    "test": "nx run-many --target=test --all",
    "test:core": "nx test core",
    "test:shared": "nx test shared",
    "test:rendering": "nx test rendering",
    "test:integrations": "npx vitest run --config libs/integrations/vitest.config.ts",
    "lint": "nx run-many --target=lint --all",
    "graph": "nx graph",
    "affected": "nx affected --target=build,test,lint",
    "cms:sync": "npx tsx libs/integrations/src/cms-sync/cms-sync.ts",
    "nx": "nx"
  },
  "dependencies": {
    "@angular/common": "~21.1.0",
    "@angular/compiler": "~21.1.0",
    "@angular/core": "~21.1.0",
    "@angular/elements": "~21.1.0",
    "@angular/forms": "~21.1.0",
    "@angular/platform-browser": "~21.1.0",
    "@angular/router": "~21.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "~21.1.0",
    "@angular-devkit/schematics": "~21.1.0",
    "@angular/build": "~21.1.0",
    "@angular/cli": "~21.1.0",
    "@angular/compiler-cli": "~21.1.0",
    "@angular/language-service": "~21.1.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "22.5.4",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/web": "22.5.4",
    "@nx/workspace": "22.5.4",
    "@schematics/angular": "~21.1.0",
    "@swc-node/register": "~1.11.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "^4.0.18",
    "angular-eslint": "^21.0.1",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jsdom": "^27.1.0",
    "ng-packagr": "^21.2.0",
    "nx": "22.5.4",
    "nx-mcp": "^0.23.0",
    "prettier": "~3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "tsx": "^4.19.4",
    "vitest": "^4.0.8"
  },
  "nx": {
    "includedScripts": []
  }
}
