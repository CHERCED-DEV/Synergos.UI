{
  "name": "macros-test-macro",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/macros/test-macro/src",
  "tags": ["scope:macros", "type:app", "macro:test-macro"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/macros/test-macro",
        "browser": "apps/macros/test-macro/src/main.ts",
        "index": "apps/macros/test-macro/src/index.html",
        "tsConfig": "apps/macros/test-macro/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/core-assets/src"]
        },
        "assets": [],
        "styles": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "umbraco": {
          "index": false,
          "outputHashing": "none",
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4201,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "macros-test-macro:build:production"
        },
        "development": {
          "buildTarget": "macros-test-macro:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "macros-test-macro:build:development",
        "port": 4201,
        "staticFilePath": "dist/apps/macros/test-macro/browser",
        "cors": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/macros/test-macro/src/**/*.ts",
          "apps/macros/test-macro/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "runner": "vitest",
        "tsConfig": "apps/macros/test-macro/tsconfig.spec.json",
        "runnerConfig": "apps/macros/test-macro/vitest.config.ts",
        "coverageReporters": ["text", "lcov", "html"]
      }
    }
  }
}
