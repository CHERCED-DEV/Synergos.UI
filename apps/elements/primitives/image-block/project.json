{
  "name": "elements-primitives-image-block",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/primitives/image-block/src",
  "tags": [
    "scope:elements",
    "tier:primitive",
    "type:app",
    "element:image-block"
  ],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "wwwroot/synergos/image-block",
        "browser": "apps/elements/primitives/image-block/src/main.ts",
        "index": "apps/elements/primitives/image-block/src/index.html",
        "tsConfig": "apps/elements/primitives/image-block/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": [
            "libs/core-assets/src"
          ]
        },
        "assets": [],
        "styles": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "100kb",
              "maximumError": "200kb"
            }
          ],
          "outputHashing": "none"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4212,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "elements-primitives-image-block:build:production"
        },
        "development": {
          "buildTarget": "elements-primitives-image-block:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "elements-primitives-image-block:build:development",
        "port": 4212,
        "staticFilePath": "wwwroot/synergos/image-block/browser",
        "cors": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/primitives/image-block/src/**/*.ts",
          "apps/elements/primitives/image-block/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "runner": "vitest",
        "tsConfig": "apps/elements/primitives/image-block/tsconfig.spec.json",
        "runnerConfig": "apps/elements/primitives/image-block/vitest.config.ts",
        "coverageReporters": [
          "text",
          "lcov",
          "html"
        ]
      }
    }
  }
}
