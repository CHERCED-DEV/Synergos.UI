{
  "name": "elements-hero",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "sg",
  "sourceRoot": "apps/elements/hero/src",
  "tags": ["scope:elements", "type:app", "element:hero"],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "wwwroot/synergos/hero",
        "browser": "apps/elements/hero/src/main.ts",
        "index": "apps/elements/hero/src/index.html",
        "tsConfig": "apps/elements/hero/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "stylePreprocessorOptions": {
          "includePaths": ["libs/core-assets/src"]
        },
        "assets": [],
        "styles": []
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "200kb",
              "maximumError": "500kb"
            }
          ],
          "outputHashing": "none"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      },
      "defaultConfiguration": "production"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "port": 4202,
        "headers": {
          "Access-Control-Allow-Origin": "*"
        }
      },
      "configurations": {
        "production": {
          "buildTarget": "elements-hero:build:production"
        },
        "development": {
          "buildTarget": "elements-hero:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "elements-hero:build:development",
        "port": 4202,
        "staticFilePath": "wwwroot/synergos/hero/browser",
        "cors": true
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/elements/hero/src/**/*.ts",
          "apps/elements/hero/src/**/*.html"
        ]
      }
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "runner": "vitest",
        "tsConfig": "apps/elements/hero/tsconfig.spec.json",
        "runnerConfig": "apps/elements/hero/vitest.config.ts",
        "coverageReporters": ["text", "lcov", "html"]
      }
    }
  }
}
